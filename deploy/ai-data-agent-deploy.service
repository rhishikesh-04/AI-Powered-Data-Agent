[Unit]
Description=AI Data Agent Automated Deployment
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/ai-data-agent
ExecStart=/usr/local/sbin/ai-data-agent-auto-deploy
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
